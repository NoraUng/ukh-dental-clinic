# Supabase Edge Function secrets — NOT read by the Supabase CLI directly
# from this file. It documents what to set and how; the actual values live
# only in Supabase's encrypted secret store, set per project (dev and prod
# are two separate Supabase projects with two separate sets of secrets).
#
# Local development:
#   supabase functions serve --env-file supabase/.env.local
#   (copy this file to supabase/.env.local, fill in real values, and never
#   commit that file — it's covered by .gitignore)
#
# Deployed dev/prod:
#   supabase secrets set --project-ref <dev-or-prod-project-ref> \
#     TURNSTILE_SECRET_KEY=... \
#     RATE_LIMIT_SALT=... \
#     ALLOWED_ORIGINS=...
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are NOT listed below because
# Supabase automatically injects them (and SUPABASE_ANON_KEY,
# SUPABASE_DB_URL) into every Edge Function's environment for the project
# it's deployed to — you never set those yourself, and they must never be
# added to this file or any Cloudflare Pages config.

# Cloudflare dashboard -> Turnstile -> your widget -> Secret Key.
# Different widgets (and therefore different secret keys) for dev vs prod.
TURNSTILE_SECRET_KEY=

# Any long random string, generated once per environment, e.g.:
#   openssl rand -hex 32
# Used only to HMAC-hash visitor IP addresses for rate limiting — the raw
# IP is never stored. Rotating this salt invalidates existing rate-limit
# history (harmless) but does not affect anything else.
RATE_LIMIT_SALT=

# Comma-separated list of the exact origins allowed to call this function.
#   dev:  http://localhost:8788,https://ukh-dental-dev.pages.dev
#   prod: https://ukhdentalclinic.com,https://ukh-dental.pages.dev
ALLOWED_ORIGINS=
