{
  "name": "ung-kheang-heang-dental-clinic-website",
  "version": "2.0.0",
  "description": "Front-end + Supabase/Cloudflare backend for Ung Kheang Heang Dental Clinic in Phnom Penh, Cambodia.",
  "main": "index.html",
  "scripts": {
    "start": "npx live-server --port=8788",
    "build": "node scripts/generate-config.js",
